<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? `${titulo} · ${gym.nombre}` : `${gym.nombre} · ${gym.lema}` %></title>
  <meta name="description" content="Horarios actualizados, planes, reserva de turnos e inscripción online en <%= gym.nombre %>.">
  <meta name="theme-color" content="#0a2d1d">
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <% (typeof estilos !== 'undefined' ? estilos : []).forEach((css) => { %>
  <link rel="stylesheet" href="/css/<%= css %>.css">
  <% }) %>
</head>
