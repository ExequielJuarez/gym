<%- include('../partials/admin-top') %>

<section class="kpis kpis--3">
  <article class="kpi"><p>Cobrado <%= periodo ? '· ' + fechas.nombrePeriodo(periodo) : '' %></p><strong class="texto-verde"><%= formatoPrecio(resumen.cobrado) %></strong><small><%= resumen.cantPagadas %> cuotas pagadas</small></article>
  <article class="kpi"><p>Pendiente</p><strong class="texto-naranja"><%= formatoPrecio(resumen.pendiente) %></strong><small><%= resumen.cantPendientes %> cuotas por cobrar</small></article>
  <article class="kpi kpi--accion">
    <p>Generar cuotas del mes</p>
    <form method="post" action="/admin/cuotas/generar" class="mini-form">
      <input type="month" name="periodo" value="<%= periodo || fechas.periodoActual() %>" aria-label="Período">
      <button class="pildora pildora--oscura pildora--chica" type="submit">Generar</button>
    </form>
    <small>Crea la cuota de cada socio activo con plan</small>
  </article>
</section>

<div class="herramientas">
  <form class="filtros" method="get" action="/admin/cuotas">
    <input type="month" name="periodo" value="<%= periodo %>" aria-label="Período" data-autoenviar>
    <select name="estado" aria-label="Estado" data-autoenviar>
      <option value="">Todas</option>
      <option value="pendiente" <%= estado === 'pendiente' ? 'selected' : '' %>>Pendientes</option>
      <option value="vencida" <%= estado === 'vencida' ? 'selected' : '' %>>Vencidas</option>
      <option value="pagada" <%= estado === 'pagada' ? 'selected' : '' %>>Pagadas</option>
    </select>
    <a class="pildora pildora--linea pildora--chica" href="/admin/cuotas?periodo=">Ver todos los períodos</a>
  </form>
</div>

<section class="tarjeta tarjeta--tabla">
  <% if (!cuotas.length) { %><p class="vacio-admin">No hay cuotas para este filtro. Probá generar las del mes.</p><% } else { %>
  <div class="tabla-scroll">
    <table class="tabla">
      <thead><tr><th scope="col">Socio</th><th scope="col">Período</th><th scope="col">Monto</th><th scope="col">Vence</th><th scope="col">Estado</th><th scope="col"><span class="solo-lectores">Cobro</span></th></tr></thead>
      <tbody>
        <% cuotas.forEach((c) => { const vencida = c.estado === 'pendiente' && c.vence < hoy; %>
          <tr>
            <td data-etiqueta="Socio"><a class="enlace-fuerte" href="/admin/socios/<%= c.socio_id %>"><%= c.Socio.apellido %>, <%= c.Socio.nombre %></a></td>
            <td data-etiqueta="Período"><%= fechas.nombrePeriodo(c.periodo) %></td>
            <td data-etiqueta="Monto"><%= formatoPrecio(c.monto) %></td>
            <td data-etiqueta="Vence"><%= fechas.fechaCorta(c.vence) %></td>
            <td data-etiqueta="Estado">
              <% if (c.estado === 'pagada') { %><span class="etiqueta-estado etiqueta-estado--pagada">Pagada · <%= c.metodo %></span>
              <% } else if (vencida) { %><span class="etiqueta-estado etiqueta-estado--vencida">Vencida</span>
              <% } else { %><span class="etiqueta-estado etiqueta-estado--pendiente">Pendiente</span><% } %>
            </td>
            <td class="tabla__acciones">
              <% if (c.estado === 'pagada') { %>
                <form method="post" action="/admin/cuotas/<%= c.id %>/anular" data-confirmar="¿Anular este pago?">
                  <input type="hidden" name="volver" value="/admin/cuotas?periodo=<%= periodo %>&estado=<%= estado %>">
                  <button class="pildora pildora--linea pildora--chica" type="submit">Anular</button>
                </form>
              <% } else { %>
                <form method="post" action="/admin/cuotas/<%= c.id %>/cobrar" class="mini-form">
                  <input type="hidden" name="volver" value="/admin/cuotas?periodo=<%= periodo %>&estado=<%= estado %>">
                  <select name="metodo" aria-label="Método de pago"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="tarjeta">Tarjeta</option></select>
                  <button class="pildora pildora--naranja pildora--chica" type="submit">Cobrar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<%- include('../partials/admin-bottom') %>
