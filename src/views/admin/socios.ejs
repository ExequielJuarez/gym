<%- include('../partials/admin-top') %>

<div class="herramientas">
  <form class="filtros" method="get" action="/admin/socios" role="search">
    <input type="search" name="q" value="<%= q %>" placeholder="Buscar por nombre, DNI o teléfono" aria-label="Buscar socio">
    <select name="estado" aria-label="Estado" data-autoenviar>
      <option value="">Todos</option>
      <option value="activo" <%= estado === 'activo' ? 'selected' : '' %>>Activos</option>
      <option value="inactivo" <%= estado === 'inactivo' ? 'selected' : '' %>>Inactivos</option>
    </select>
    <button class="pildora pildora--oscura pildora--chica" type="submit">Buscar</button>
  </form>
  <a class="pildora pildora--verde pildora--chica" href="/admin/socios/nuevo">+ Nuevo socio</a>
</div>

<section class="tarjeta tarjeta--tabla">
  <% if (!socios.length) { %>
    <p class="vacio-admin">No encontramos socios con esos filtros.</p>
  <% } else { %>
  <div class="tabla-scroll">
    <table class="tabla">
      <caption class="solo-lectores"><%= socios.length %> socios</caption>
      <thead><tr><th scope="col">Socio</th><th scope="col">DNI</th><th scope="col">Plan</th><th scope="col">Teléfono</th><th scope="col">Estado</th><th scope="col"><span class="solo-lectores">Acciones</span></th></tr></thead>
      <tbody>
        <% socios.forEach((s) => { %>
          <tr>
            <td data-etiqueta="Socio"><div class="celda-persona"><span class="mini-avatar" aria-hidden="true"><%= s.nombre[0] %><%= s.apellido[0] %></span><a class="enlace-fuerte" href="/admin/socios/<%= s.id %>"><%= s.apellido %>, <%= s.nombre %></a></div></td>
            <td data-etiqueta="DNI"><%= s.dni %></td>
            <td data-etiqueta="Plan"><%= s.Plan ? s.Plan.nombre : '—' %></td>
            <td data-etiqueta="Teléfono"><%= s.telefono || '—' %></td>
            <td data-etiqueta="Estado"><span class="etiqueta-estado etiqueta-estado--<%= s.estado %>"><%= s.estado %></span></td>
            <td class="tabla__acciones"><a class="pildora pildora--linea pildora--chica" href="/admin/socios/<%= s.id %>/editar">Editar</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<%- include('../partials/admin-bottom') %>
